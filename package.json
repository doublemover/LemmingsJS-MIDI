{
  "name": "lemmings-js-midi",
  "version": "0.0.4",
  "description": "Lemmings (JavaScript)",
  "private": true,
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "start": "http-server --cors=*",
    "start-https": "http-server --cors=* -S -C certs/localhost.pem -K certs/localhost-key.pem",
    "mcp": "node mcp/server.js",
    "mcpb:build": "node scripts/build-mcpb-bundle.js",
    "mcpb:validate": "npm run mcpb:build && npx @anthropic-ai/mcpb validate dist/mcpb",
    "check-undefined": "node scripts/check-undefined.js",
    "test": "node scripts/runTests.js",
    "test-core": "mocha \"test/*game*.test.js\"",
    "test-bench": "mocha \"test/bench*.test.js\"",
    "test-workflow": "mocha \"test/*workflow*.test.js\"",
    "test-tools": "mocha \"test/tools/*.test.js\"",
    "test-offline-tools": "node scripts/runTests.js offline-tools",
    "test-editor": "mocha \"test/editor/*.test.js\"",
    "test-e2e": "playwright test",
    "test-e2e:harness": "playwright test e2e/harness.game.spec.js e2e/harness.editor.spec.js",
    "test-e2e:ui": "playwright test --ui",
    "test-e2e:install": "playwright install chromium",
    "check-mcp-clients": "node scripts/check-mcp-client-compat.js",
    "test-mcp-smoke": "node scripts/mcp-smoke.js",
    "bench-performance": "node scripts/bench-performance.js",
    "bench-history": "node scripts/bench-history-stress.js",
    "coverage": "cross-env C8_FORK=1 c8 mocha --recursive",
    "coverage-editor": "cross-env C8_FORK=1 c8 --include=js/editor/** --check-coverage --lines 100 --statements 100 --functions 100 --branches 100 mocha \"test/editor/*.test.js\"",
    "coverage-report": "npx c8 report --reporter=html",
    "count-lines": "node scripts/count-lines.js",
    "export-panel-sprite": "node tools/exportPanelSprite.js",
    "export-lemmings-sprites": "node tools/exportLemmingsSprites.js",
    "export-ground-images": "node tools/exportGroundImages.js",
    "export-all-sprites": "node tools/exportAllSprites.js",
    "export-all-packs": "node tools/exportAllPacks.js",
    "clean-exports": "node tools/cleanExports.js",
    "list-sprites": "node tools/listSprites.js",
    "patch-sprites": "node tools/patchSprites.js",
    "pack-levels": "node tools/packLevels.js",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "depcheck": "depcheck"
  },
  "c8": {
    "check-coverage": true,
    "lines": 71,
    "statements": 71,
    "functions": 72,
    "branches": 85,
    "exclude": [
      "coverage/**",
      "test/**",
      "js/xbrz/**",
      "js/vendor/**",
      "js/vendor/jquery.js",
      "js/vendor/webmidi.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doublemover/LemmingsJS-MIDI.git"
  },
  "bugs": {
    "url": "https://github.com/doublemover/LemmingsJS-MIDI/issues"
  },
  "homepage": "https://github.com/doublemover/LemmingsJS-MIDI#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/test": "^1.49.1",
    "@sinonjs/fake-timers": "^14.0.0",
    "acorn": "^8.14.1",
    "adm-zip": "^0.5.16",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "cheerio": "^1.0.0",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "eslint": "^9.28.0",
    "http-server": "^14.1.1",
    "mocha": "^11.5.0",
    "node-unrar-js": "^2.0.2",
    "pngjs": "^7.0.0",
    "tar": "^7.4.3",
    "ws": "^8.18.1",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
