{
  "schema": "lemmings-sound-recipes/v1",
  "pack": {
    "id": "lemmings.fm-forge",
    "version": "0.1.0",
    "name": "FM Forge",
    "author": "LemmingsJS-MIDI contributors",
    "sourceUrl": "https://github.com/doublemover/LemmingsJS-MIDI",
    "licenseId": "NOASSERTION",
    "licenseUrl": null,
    "attribution": "Original declarative FM working recipes; redistribution terms have not been assigned. Numerical and listening qualification remains pending.",
    "modifications": [],
    "redistributionPolicy": "unknown",
    "licenses": []
  },
  "files": [],
  "recipes": [
    {
      "id": "forge.base",
      "revision": 1,
      "abstract": true,
      "author": "LemmingsJS-MIDI contributors",
      "tags": ["fm", "physical-strike", "unqualified-content"],
      "engine": { "id": "native-fm", "version": 1 },
      "rights": {
        "kind": "patch-recipe",
        "creator": "LemmingsJS-MIDI contributors",
        "sourceUrl": "https://github.com/doublemover/LemmingsJS-MIDI",
        "licenseId": "NOASSERTION",
        "licenseUrl": null,
        "attribution": "Original two/four-operator FM recipe definitions; no hardware emulation or clearance claim.",
        "modifications": [],
        "declaredUse": "unknown"
      },
      "components": [
        { "id": "exciter", "role": "exciter", "parameters": {
          "carrierRatio": { "value": 1, "unit": "ratio" },
          "modulatorRatio": { "value": 2, "unit": "ratio" },
          "dualPair": { "value": 0, "unit": "enum" },
          "secondaryCarrierRatio": { "value": 1, "unit": "ratio" },
          "secondaryModulatorRatio": { "value": 1, "unit": "ratio" },
          "pitchSettleCents": { "value": 0, "unit": "cents" },
          "pitchSettleSeconds": { "value": 0.035, "unit": "s" },
          "maxBendCents": { "value": 200, "unit": "cents" }
        } },
        { "id": "modulation", "role": "modulation", "parameters": {
          "indexStart": { "value": 1, "unit": "dimensionless" },
          "indexEnd": { "value": 0.1, "unit": "dimensionless" },
          "indexSeconds": { "value": 0.3, "unit": "s" },
          "secondaryIndexStart": { "value": 0, "unit": "dimensionless" },
          "secondaryIndexEnd": { "value": 0, "unit": "dimensionless" }
        } },
        { "id": "envelope", "role": "envelope", "parameters": {
          "attackSeconds": { "value": 0.002, "unit": "s" },
          "decaySeconds": { "value": 1.4, "unit": "s" },
          "sustain01": { "value": 0, "unit": "ratio" },
          "releaseSeconds": { "value": 0.06, "unit": "s" }
        } },
        { "id": "output", "role": "output", "parameters": {
          "gain01": { "value": 0.4, "unit": "amplitude-linear" },
          "pan01": { "value": 0, "unit": "normalized" },
          "secondaryMix01": { "value": 0, "unit": "ratio" }
        } }
      ],
      "voicePolicy": { "maxVoices": 16, "steal": "reject" },
      "mix": { "gain01": 0.6, "pan01": 0 },
      "dependencies": []
    },
    {
      "id": "forge.glass-rivet", "revision": 1, "extends": "forge.base", "name": "Glass Rivet",
      "components": [
        { "id": "exciter", "role": "exciter", "parameters": { "modulatorRatio": { "value": 2.71, "unit": "ratio" } } },
        { "id": "modulation", "role": "modulation", "parameters": {
          "indexStart": { "value": 3.5, "unit": "dimensionless" }, "indexEnd": { "value": 0.15, "unit": "dimensionless" }, "indexSeconds": { "value": 0.8, "unit": "s" }
        } }
      ]
    },
    {
      "id": "forge.copper-tine", "revision": 1, "extends": "forge.base", "name": "Copper Tine",
      "components": [
        { "id": "exciter", "role": "exciter", "parameters": { "dualPair": { "value": 1, "unit": "enum" } } },
        { "id": "modulation", "role": "modulation", "parameters": {
          "indexStart": { "value": 1.6, "unit": "dimensionless" }, "indexEnd": { "value": 0.1, "unit": "dimensionless" }, "indexSeconds": { "value": 0.18, "unit": "s" }
        } },
        { "id": "envelope", "role": "envelope", "parameters": { "decaySeconds": { "value": 1.8, "unit": "s" } } },
        { "id": "output", "role": "output", "parameters": { "secondaryMix01": { "value": 0.7, "unit": "ratio" }, "gain01": { "value": 0.36, "unit": "amplitude-linear" } } }
      ]
    },
    {
      "id": "forge.alarm-bloom", "revision": 1, "extends": "forge.base", "name": "Alarm Bloom",
      "components": [
        { "id": "exciter", "role": "exciter", "parameters": { "modulatorRatio": { "value": 1.414, "unit": "ratio" } } },
        { "id": "modulation", "role": "modulation", "parameters": {
          "indexStart": { "value": 0.5, "unit": "dimensionless" }, "indexEnd": { "value": 4, "unit": "dimensionless" }, "indexSeconds": { "value": 0.7, "unit": "s" }
        } },
        { "id": "envelope", "role": "envelope", "parameters": { "attackSeconds": { "value": 0.01, "unit": "s" }, "decaySeconds": { "value": 1.2, "unit": "s" }, "releaseSeconds": { "value": 0.08, "unit": "s" } } },
        { "id": "output", "role": "output", "parameters": { "gain01": { "value": 0.22, "unit": "amplitude-linear" } } }
      ]
    },
    {
      "id": "forge.rubber-bolt", "revision": 1, "extends": "forge.base", "name": "Rubber Bolt",
      "components": [
        { "id": "exciter", "role": "exciter", "parameters": { "modulatorRatio": { "value": 1, "unit": "ratio" }, "pitchSettleCents": { "value": 700, "unit": "cents" } } },
        { "id": "modulation", "role": "modulation", "parameters": {
          "indexStart": { "value": 4, "unit": "dimensionless" }, "indexEnd": { "value": 0.3, "unit": "dimensionless" }, "indexSeconds": { "value": 0.08, "unit": "s" }
        } },
        { "id": "envelope", "role": "envelope", "parameters": { "attackSeconds": { "value": 0.001, "unit": "s" }, "decaySeconds": { "value": 0.26, "unit": "s" }, "releaseSeconds": { "value": 0.02, "unit": "s" } } },
        { "id": "output", "role": "output", "parameters": { "gain01": { "value": 0.45, "unit": "amplitude-linear" } } }
      ]
    }
  ]
}
