{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noResolve": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "js/game/HistoryStore.js",
    "js/render/Stage.js",
    "js/level/Trigger.js"
  ]
}
