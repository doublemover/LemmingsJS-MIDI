{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "noResolve": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "js/game/HistoryStore.js",
    "js/game/history/**/*.js",
    "js/render/Stage.js",
    "js/app/midi-ui/midiUiDebug.js",
    "js/app/midi-ui/midiUiDevices.js",
    "js/app/midi-ui/midiUiFeatureFlags.js",
    "js/app/midi-ui/midiUiIntent.js",
    "js/app/midi-ui/midiUiRefreshSections.js",
    "js/editor/editor-controller/EditorControllerPointer.js",
    "js/editor/editor-controller/EditorControllerPointerInput.js",
    "js/editor/editor-controller/EditorControllerPointerSelection.js",
    "js/editor/editor-controller/EditorControllerPointerTools.js",
    "js/app/editor-ui/EditorUiBindings.js",
    "js/app/editor-ui/EditorUiBindingControls.js",
    "js/app/editor-ui/EditorUiBindingLifecycle.js",
    "js/app/editor-ui/EditorUiBindingTools.js",
    "js/app/e2e/E2EEditorApplyHelpers.js",
    "js/level/Trigger.js",
    "mcp/toolRouting.js"
  ]
}
